# anmol.am Portfolio - Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================

# Vercel Analytics (Optional)
# Get your analytics ID from Vercel dashboard
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# =============================================================================
# CONTACT FORM CONFIGURATION
# =============================================================================

# Email Service - Choose one of the options below

# Option 1: Resend (Recommended)
# Sign up at https://resend.com for free tier (3,000 emails/month)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=your@email.com

# Option 2: SendGrid (Alternative)
# Uncomment if using SendGrid instead of Resend
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_TO=your@email.com

# Option 3: Custom SMTP (Advanced)
# Uncomment if using custom SMTP server
# SMTP_HOST=smtp.youremailprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=true
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_TO=your@email.com

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================

# GitHub Personal Access Token (Optional)
# Used for higher rate limits (5000/hour vs 60/hour)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo (or no scopes for public data)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# GitHub Username (Required for activity feed)
# Change this to your GitHub username
NEXT_PUBLIC_GITHUB_USERNAME=anmolmanchanda

# =============================================================================
# SITE CONFIGURATION
# =============================================================================

# Site URL (Required for proper SEO and redirects)
# Development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (Update when deploying)
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# =============================================================================
# VIEW TRACKING CONFIGURATION
# =============================================================================

# Upstash Redis (Required for view tracking and data storage)
# Get from Upstash dashboard: https://console.upstash.com/
# Create a Redis database and copy the REST API credentials
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# IMPORTANT: Also set these for compatibility with Vercel KV
KV_REST_API_URL=https://your-redis-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_rest_token

# IP Salt for hashing (SECURITY - REQUIRED!)
# This salt is used to hash IP addresses for privacy protection
# Generate a secure random string: openssl rand -base64 32
# NEVER commit this value to git! Keep it secret in .env.local
# Example: IP_SALT=8h3k9f2j4n6m8p0q2r4t6v8w0y2a4c6e8g
IP_SALT=CHANGE_THIS_TO_A_RANDOM_STRING_MINIMUM_32_CHARACTERS

# =============================================================================
# EXTERNAL API INTEGRATIONS
# =============================================================================

# Strava OAuth 2.0 (For running/fitness tracking)
# Register app at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REFRESH_TOKEN=your_strava_refresh_token
STRAVA_ATHLETE_ID=131445218

# Duolingo (Public API - no auth needed)
DUOLINGO_USERNAME=manchandaanmol

# Letterboxd (RSS Feed - no auth needed)
LETTERBOXD_USERNAME=anmolmanchanda

# Goodreads (RSS Feed - no auth needed)
GOODREADS_USER_ID=83373769

# WakaTime (Optional - for coding stats)
# WAKATIME_API_KEY=waka_your_api_key

# Spotify API credentials (Future enhancement)
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Admin Password Configuration (IMPORTANT - CHANGE THIS!)
# The /admin page allows you to update your personal stats (books read, km run, etc.)
# Default password is "admin123" which is INSECURE!
#
# To set a secure admin password:
# 1. Choose a strong password (e.g., "mySecurePassword123!")
# 2. Generate SHA-256 hash: echo -n "mySecurePassword123!" | shasum -a 256
# 3. Copy the hash (first part, without the trailing " -")
# 4. Set ADMIN_PASSWORD_HASH below to that hash
#
# Example:
# Password: "mySecurePassword123!"
# Hash: 5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8
#
# If you don't use /admin, you can leave this unset (but anyone can access with "admin123")
ADMIN_PASSWORD_HASH=

# NextAuth Secret (If implementing authentication)
# Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET=your_nextauth_secret

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable debug logging in development
# NODE_ENV=development

# Database URL (If adding database functionality)
# DATABASE_URL=your_database_connection_string

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment Platform
# VERCEL=1 (automatically set by Vercel)

# Custom Build Configuration
# NEXT_PUBLIC_BUILD_ID=your_custom_build_id

# =============================================================================
# INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env.local
# 2. Fill in the values you need (not all are required)
# 3. Never commit .env.local to git (it's in .gitignore)
# 4. For production, set these in your deployment platform
# 5. Restart your development server after making changes

# =============================================================================
# REQUIRED vs OPTIONAL
# =============================================================================

# REQUIRED for basic functionality:
# - EMAIL_* variables (for contact form)
# - NEXT_PUBLIC_SITE_URL (for proper SEO)

# OPTIONAL but recommended:
# - NEXT_PUBLIC_VERCEL_ANALYTICS_ID (for analytics)
# - GITHUB_TOKEN (for higher API rate limits)

# OPTIONAL for future enhancements:
# - SPOTIFY_* variables
# - NEXTAUTH_SECRET
# - DATABASE_URL